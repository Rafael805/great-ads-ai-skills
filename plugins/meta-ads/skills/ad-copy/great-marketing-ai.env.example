# Great Ads AI — Connect to Claude
# Copy to ~/.config/great-marketing-ai/great-marketing-ai.env and fill in your key.
# Generate the key in the dashboard: Settings → Integrations → Connect to Claude.
#
# This is the ONLY credential the /ad-copy skill needs. It only reads your brand's
# voice/guardrails (a "read" scope key is enough) — free, no credits billed.

GREAT_ADS_INTERNAL_API_KEY=gaa_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GREAT_ADS_INTERNAL_BASE_URL=https://www.greatads.io
